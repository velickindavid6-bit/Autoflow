# Скопируйте этот файл в .env и поправьте значения
PORT=3000
HOST=127.0.0.1
# development | production (в production cookie получают флаг Secure и включается HSTS)
NODE_ENV=development
# true — только если сервер стоит ЗА reverse-proxy (nginx, Render, Railway и т.п.)
TRUST_PROXY=false
# Сколько дней живёт сессия без активности
SESSION_DAYS=7

# --- Этап 3: письма (подтверждение email, сброс пароля) ---
# Адрес сайта для ссылок в письмах. В production ОБЯЗАТЕЛЕН (например https://autoflow.kz), без слэша на конце
APP_URL=
# console — письма печатаются в консоль сервера (для разработки) | resend — через resend.com | smtp — через любую почту
MAIL_TRANSPORT=console
# От чьего имени уходят письма. Адрес должен принадлежать вашему домену или почтовому сервису
MAIL_FROM=AutoFlow <no-reply@example.com>
# Куда пересылать сообщения из формы «Контакты» (необязательно, сообщения всё равно сохраняются в БД)
CONTACT_TO=
# Ключ Resend (нужен при MAIL_TRANSPORT=resend; домен в MAIL_FROM должен быть подтверждён в Resend)
RESEND_API_KEY=
# Настройки SMTP (нужны при MAIL_TRANSPORT=smtp). Поддерживается защищённое соединение на порту 465
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Этап 4: Telegram-бот ---
# Токен от @BotFather (вид 123456789:AAH...). СЕКРЕТ: никому не показывайте и не публикуйте этот файл.
# Если токен попал не туда, в @BotFather выполните /revoke и получите новый.
TELEGRAM_BOT_TOKEN=

# --- Этап 6: оплата (заглушка) ---
# off  — оплата выключена: платные тарифы получить нельзя (по умолчанию в production, безопасно)
# demo — демонстрационная оплата: деньги НЕ списываются, платный тариф выдаётся бесплатно (по умолчанию при разработке)
# Для портфолио-версии на публичном сайте можно явно включить demo; для настоящих клиентов нужна реальная платёжная система.
PAYMENTS_MODE=
